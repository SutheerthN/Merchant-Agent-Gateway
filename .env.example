# Merchant Agent Gateway (MAG) - Environment Configuration Template
# Copy this file to .env for local overrides

# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Test Mode Credentials (To be configured in Milestone 3)
# Get your Test Keys from Razorpay Dashboard: Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret

# AI Agent Configuration (Optional - Simulator active by default)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
